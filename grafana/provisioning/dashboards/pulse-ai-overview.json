{
  "uid": "pulse-ai-overview",
  "title": "Pulse AI - Service Overview",
  "description": "Provisioned from grafana/provisioning/dashboards. UI edits are allowed but the file wins on restart - change the JSON to make them stick.",
  "tags": [
    "pulse-ai"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape target",
      "description": "Is Prometheus reaching /actuator/prometheus. 0 means the app is down or the route is not public.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#d03b3b",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "#0ca30c",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "up{job=\"pulse-ai\"}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / sec",
      "description": "All endpoints, 5m rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile across all endpoints, from the server-side histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "description": "Busiest 5 endpoints. Capped at 5 on purpose: beyond that the lines stop being distinguishable.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "none",
            "axisBorderShow": false,
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "topk(5, sum(rate(http_server_requests_seconds_count[5m])) by (uri))",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "description": "Slowest-tail per endpoint, worst 5.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "none",
            "axisBorderShow": false,
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri)))",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "5xx error rate",
      "description": "No 5xx yet means the series does not exist, so \"or vector(0)\" pins it to a real zero instead of rendering \"No data\".",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "#d03b3b"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "none",
            "axisBorderShow": false,
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) or vector(0)",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "5xx / sec"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Hikari connection pool",
      "description": "Pending above zero means threads are queueing for a connection - the pool is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "none",
            "axisBorderShow": false,
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Active"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Idle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "hikaricp_connections_active{pool=\"MainPool\"}",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "Active"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "hikaricp_connections_idle{pool=\"MainPool\"}",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "legendFormat": "Idle"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "hikaricp_connections_pending{pool=\"MainPool\"}",
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "legendFormat": "Pending"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM heap",
      "description": "Used against max. A sawtooth is normal GC; a rising floor is a leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "none",
            "axisBorderShow": false,
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "Used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulse-prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "legendFormat": "Max"
        }
      ]
    }
  ]
}